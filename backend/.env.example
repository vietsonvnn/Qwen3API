# Alibaba Cloud Qwen3 TTS
QWEN_API_KEY=sk-your_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Database (PostgreSQL — Railway, Neon, or any provider)
DATABASE_URL=postgresql://postgres:password@localhost:5432/qwen_voice

# Google OAuth (create at console.cloud.google.com → APIs → Credentials → OAuth 2.0)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key

# Server
PORT=3001

# CORS — frontend origin (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible)
# - Account ID:  Cloudflare dashboard → R2 sidebar (top-right)
# - Access keys: R2 → Manage R2 API Tokens → Create API token (R/W)
# - Bucket:      R2 → Create bucket (recommended: single bucket "qwen-voice-audio")
# - Public URL:  R2 → bucket → Settings → Public access → Custom domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=qwen-voice-audio
R2_PUBLIC_URL=https://audio.your-domain.com

# FFmpeg (leave empty — Railway/Nixpacks installs it automatically)
FFMPEG_PATH=

# Optional — storage retention for completed TTS audio (days)
STORAGE_RETENTION_DAYS=3
